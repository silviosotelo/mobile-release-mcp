{
  "name": "mobile-release-mcp",
  "version": "0.1.0",
  "description": "MCP server for mobile release automation: fastlane (match, snapshot, beta, release), Shorebird OTA, App Store Connect & Google Play — for Flutter / iOS / Android projects.",
  "license": "MIT",
  "author": "Silvio Sotelo",
  "type": "module",
  "repository": { "type": "git", "url": "git+https://github.com/silviosotelo/mobile-release-mcp.git" },
  "homepage": "https://github.com/silviosotelo/mobile-release-mcp#readme",
  "bugs": { "url": "https://github.com/silviosotelo/mobile-release-mcp/issues" },
  "publishConfig": { "access": "public" },
  "bin": {
    "mobile-release-mcp": "dist/index.js"
  },
  "files": [
    "dist",
    "examples",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc",
    "dev": "tsc -w",
    "start": "node dist/index.js",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "fastlane",
    "shorebird",
    "flutter",
    "ios",
    "android",
    "app-store",
    "google-play",
    "release-automation"
  ],
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "typescript": "^5.5.4"
  }
}
